{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build": {
      "dependsOn": ["@modern-cms/api#db:generate", "^build"],
      "outputs": ["dist/**", "build/**", "openapi/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["@modern-cms/api#db:generate", "^build"]
    },
    "typecheck": {
      "dependsOn": ["@modern-cms/api#db:generate", "^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
