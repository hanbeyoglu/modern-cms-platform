{
  "name": "modern-cms",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev --filter=@modern-cms/api --filter=@modern-cms/admin --filter=@modern-cms/worker",
    "dev:api": "pnpm --filter @modern-cms/api dev",
    "dev:admin": "pnpm --filter @modern-cms/admin dev",
    "dev:worker": "pnpm --filter @modern-cms/worker dev",
    "dev:services": "docker compose -f docker-compose.yml up -d postgres redis",
    "dev:full": "pnpm dev:services && pnpm dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @modern-cms/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @modern-cms/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @modern-cms/api exec prisma db seed",
    "compose:config": "docker compose -f docker-compose.yml config >/dev/null && docker compose --env-file .env.production.example -f docker-compose.prod.yml config >/dev/null",
    "smoke:prod": "bash infra/scripts/smoke-prod.sh",
    "backup:postgres": "bash infra/scripts/backup-postgres.sh",
    "restore:postgres": "bash infra/scripts/restore-postgres.sh",
    "backup:prune": "bash infra/scripts/prune-backups.sh"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
