# ═══════════════════════════════════════════════════════════════════════════
# Monorepo kökü — yerel geliştirme ve Docker ile hizalı ortak değişkenler
# ═══════════════════════════════════════════════════════════════════════════

# ─── Zorunlu (API + worker üretim) ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms?schema=public
REDIS_URL=redis://localhost:6379

# ─── API ───────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# Virgülle ayrılmış izinli kökenler (boş bırakılırsa geliştirmede geniş CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# İsteğe bağlı: yükleme dizini (varsayılan: ./storage)
# STORAGE_ROOT=

# Build / sürüm metadata (Docker build args ile set edilir)
# APP_VERSION=0.0.0
# APP_GIT_SHA=
# APP_BUILD_TIME=

# ─── Admin (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─── Worker ─────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=5000
# SCHEDULING_BATCH_SIZE=40

# ─── Üretim Docker ──────────────────────────────────────────────────────────
# Üretim için `.env.production.example` dosyasına bakın.
