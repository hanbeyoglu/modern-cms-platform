# ═══════════════════════════════════════════════════════════════════════════
# Monorepo kökü — yerel geliştirme ve Docker ile hizalı ortak değişkenler
# ═══════════════════════════════════════════════════════════════════════════

# ─── Zorunlu (API + worker üretim) ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms?schema=public
# Neon/serverless: pooled endpoint önerilir. API ve worker havuz boyutları ayrı sınırlandırılır.
# PRISMA_CONNECTION_LIMIT=8
# PRISMA_POOL_TIMEOUT=20
# WORKER_PRISMA_CONNECTION_LIMIT=2
REDIS_URL=redis://localhost:6379

# ─── API ───────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# Virgülle ayrılmış izinli kökenler (boş bırakılırsa geliştirmede geniş CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# İsteğe bağlı: yükleme dizini (R2 yapılandırılmadığında yerel depolama)
# STORAGE_ROOT=

# ─── Cloudflare R2 (önerilen — yapılandırıldığında yerel depolama devre dışı) ─
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.example.com

# Build / sürüm metadata (Docker build args ile set edilir)
# APP_VERSION=0.0.0
# APP_GIT_SHA=
# APP_BUILD_TIME=

# ─── Admin (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─── Worker ─────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=5000
# SCHEDULING_BATCH_SIZE=40

# ─── TMDB (film sağlayıcı — tenant ayarı yoksa fallback) ───────────────────
# TMDB_API_READ_ACCESS_TOKEN=
# TMDB_API_KEY=

# ─── Audit (enterprise) ─────────────────────────────────────────────────────
# Audit logging is temporarily disabled for MVP/demo deployments.
# Enterprise customers can enable it through AUDIT_ENABLED=true.
AUDIT_ENABLED=false

# ─── Üretim Docker ──────────────────────────────────────────────────────────
# Üretim için `.env.production.example` dosyasına bakın.
