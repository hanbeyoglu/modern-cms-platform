# Dağıtım (örnek — doğrudan bu dosya ile de çalışır):
#   docker compose --env-file .env.production.example -f docker-compose.prod.yml up -d
# Gerçek üretimde bu dosyayı kopyalayıp değerleri güncelleyin; dosyayı git’e eklemeyin.

# ─── PostgreSQL (compose iç servis) ───────────────────────────────────────
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cms

# ─── Uygulama (API + worker; host’tan compose’a geçer) ─────────────────────
# Aynı veritabanı kullanıcısı ile internal hostname `postgres`
DATABASE_URL=postgresql://cms:change-me-strong-password@postgres:5432/cms?schema=public
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-to-at-least-32-characters-secret-value

API_PORT=4000
API_PUBLISH_PORT=4000
ADMIN_PUBLISH_PORT=8080

# Tarayıcıdan erişilen API tabanı (admin statik build’de kullanılır)
VITE_API_URL=http://localhost:4000

# İsteğe bağlı CORS (boş bırakılırsa Nest geniş CORS açar — üretimde mutlaka doldurun)
# CORS_ORIGINS=https://admin.example.com

WORKER_POLL_INTERVAL_MS=60000

# İsteğe bağlı: imaj build sırasında metadata
# GIT_SHA=
# BUILD_TIME=
# APP_VERSION=1.0.0
