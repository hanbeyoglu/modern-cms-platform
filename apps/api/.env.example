# @modern-cms/api — Nest uygulaması (çalışma dizini: apps/api)
# Kök `.env` veya buradaki `.env` Nest ConfigModule tarafından yüklenir.

# ─── Zorunlu ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms?schema=public
REDIS_URL=redis://localhost:6379

# ─── Sunucu ─────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# ─── CORS (üretimde mutlaka daraltın) ──────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── İsteğe bağlı ───────────────────────────────────────────────────────────
# Yerel depolama (R2 yapılandırılmadığında)
# STORAGE_ROOT=/absolute/path/to/storage

# Cloudflare R2 (yapılandırıldığında tüm medya yüklemeleri R2'ye gider)
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.example.com

# Docker / CI metadata (otomatik set edilebilir)
# APP_VERSION=0.0.0
# APP_GIT_SHA=abc123
# APP_BUILD_TIME=2026-05-14T12:00:00Z

# Audit logging is temporarily disabled for MVP/demo deployments.
# Enterprise customers can enable it through AUDIT_ENABLED=true.
AUDIT_ENABLED=false
