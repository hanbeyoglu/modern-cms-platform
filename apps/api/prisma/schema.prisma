generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  DELETED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum MallStatus {
  DRAFT
  LIVE
  MAINTENANCE
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String?
  lastName     String?
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenantUsers    TenantUser[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]    @relation("AuditActor")
  mediaFolders   MediaFolder[] @relation("FolderCreator")
  uploadedAssets MediaAsset[]  @relation("AssetUploader")
  createdSliders Slider[]      @relation("SliderCreator")
  updatedSliders Slider[]      @relation("SliderUpdater")
  createdGlobalStores GlobalStore[] @relation("GlobalStoreCreator")
  updatedGlobalStores GlobalStore[] @relation("GlobalStoreUpdater")
  createdMallStores     MallStore[]     @relation("MallStoreCreator")
  updatedMallStores     MallStore[]     @relation("MallStoreUpdater")
  createdEvents         Event[]         @relation("EventCreator")
  updatedEvents         Event[]         @relation("EventUpdater")
  createdCampaigns      Campaign[]      @relation("CampaignCreator")
  updatedCampaigns      Campaign[]      @relation("CampaignUpdater")
  createdCinemas        Cinema[]        @relation("CinemaCreator")
  updatedCinemas        Cinema[]        @relation("CinemaUpdater")
  createdMovies         Movie[]         @relation("MovieCreator")
  updatedMovies         Movie[]         @relation("MovieUpdater")
  createdMovieSessions  MovieSession[]  @relation("MovieSessionCreator")
  updatedMovieSessions  MovieSession[]  @relation("MovieSessionUpdater")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  malls        Mall[]
  tenantUsers  TenantUser[]
  auditLogs    AuditLog[]
  mediaFolders MediaFolder[]
  mediaAssets  MediaAsset[]
  sliders       Slider[]
  mallStores    MallStore[]
  events        Event[]
  campaigns     Campaign[]
  cinemas       Cinema[]
  movies        Movie[]
  movieSessions MovieSession[]
}

model Mall {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  status    MallStatus @default(LIVE)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userMallAccesses UserMallAccess[]
  auditLogs        AuditLog[]
  mediaFolders     MediaFolder[]
  mediaAssets      MediaAsset[]
  sliders          Slider[]
  mallStores       MallStore[]
  events           Event[]
  campaigns        Campaign[]
  cinemas          Cinema[]
  movieSessions    MovieSession[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantUsers     TenantUser[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model TenantUser {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  mallAccess UserMallAccess[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

model UserMallAccess {
  id           String     @id @default(cuid())
  tenantUserId String
  mallId       String
  tenantUser   TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  mall         Mall       @relation(fields: [mallId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([tenantUserId, mallId])
  @@index([mallId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  mallId      String?
  mall        Mall?    @relation(fields: [mallId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

// ─── Media ────────────────────────────────────────────────────────────────────

model MediaFolder {
  id        String   @id @default(cuid())
  tenantId  String
  mallId    String?
  parentId  String?
  name      String
  slug      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall     Mall?         @relation(fields: [mallId], references: [id], onDelete: SetNull)
  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderHierarchy")
  creator  User          @relation("FolderCreator", fields: [createdBy], references: [id])
  assets   MediaAsset[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([mallId])
}

model MediaAsset {
  id           String    @id @default(cuid())
  tenantId     String
  mallId       String?
  folderId     String?
  uploadedBy   String
  originalName String
  fileName     String
  mimeType     String
  extension    String
  size         Int
  width        Int?
  height       Int?
  storageKey   String    @unique
  publicUrl    String
  altText      String?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall     Mall?        @relation(fields: [mallId], references: [id], onDelete: SetNull)
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader User         @relation("AssetUploader", fields: [uploadedBy], references: [id])

  slidersDesktop Slider[] @relation("SliderDesktopMedia")
  slidersMobile  Slider[] @relation("SliderMobileMedia")
  slidersVideo   Slider[] @relation("SliderVideoMedia")
  globalStoreLogos GlobalStore[] @relation("GlobalStoreLogo")
  mallStoreLocalLogos MallStore[] @relation("MallStoreLocalLogo")
  eventCovers      Event[]      @relation("EventCoverMedia")
  campaignCovers   Campaign[]   @relation("CampaignCoverMedia")
  cinemaLogos      Cinema[]     @relation("CinemaLogoMedia")
  moviePosters     Movie[]      @relation("MoviePosterMedia")

  @@index([tenantId, createdAt])
  @@index([tenantId, folderId])
  @@index([mallId])
}

// ─── Sliders ──────────────────────────────────────────────────────────────────

enum SliderStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SliderTargetDevice {
  ALL
  DESKTOP
  MOBILE
}

enum SliderLinkType {
  NONE
  EXTERNAL_URL
  INTERNAL_PAGE
  EVENT
  CAMPAIGN
  STORE
}

model Slider {
  id             String             @id @default(cuid())
  tenantId       String
  mallId         String?
  title          String
  subtitle       String?
  description    String?
  desktopMediaId String?
  mobileMediaId  String?
  videoMediaId   String?
  linkType       SliderLinkType     @default(NONE)
  linkValue      String?
  buttonText     String?
  startAt        DateTime?
  endAt          DateTime?
  sortOrder      Int                @default(0)
  status         SliderStatus       @default(DRAFT)
  targetDevice   SliderTargetDevice @default(ALL)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall          Mall?       @relation(fields: [mallId], references: [id], onDelete: SetNull)
  desktopMedia  MediaAsset? @relation("SliderDesktopMedia", fields: [desktopMediaId], references: [id], onDelete: SetNull)
  mobileMedia   MediaAsset? @relation("SliderMobileMedia", fields: [mobileMediaId], references: [id], onDelete: SetNull)
  videoMedia    MediaAsset? @relation("SliderVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)
  createdByUser User        @relation("SliderCreator", fields: [createdBy], references: [id])
  updatedByUser User?       @relation("SliderUpdater", fields: [updatedBy], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, mallId])
  @@index([tenantId, sortOrder])
}

// ─── Store Center (global pool + mall assignment) ─────────────────────────────

enum StoreCategoryStatus {
  ACTIVE
  PASSIVE
}

enum StoreStatus {
  ACTIVE
  PASSIVE
  ARCHIVED
}

model StoreCategory {
  id        String              @id @default(cuid())
  name      String
  slug      String              @unique
  icon      String?
  sortOrder Int                 @default(0)
  status    StoreCategoryStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  globalStores GlobalStore[]

  @@index([status])
  @@index([sortOrder])
}

model GlobalStore {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  logoMediaId     String?
  categoryId      String?
  description     String?
  websiteUrl      String?
  socialLinksJson Json?
  status          StoreStatus @default(ACTIVE)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  category        StoreCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logoMedia       MediaAsset?    @relation("GlobalStoreLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  createdByUser   User           @relation("GlobalStoreCreator", fields: [createdBy], references: [id])
  updatedByUser   User?          @relation("GlobalStoreUpdater", fields: [updatedBy], references: [id])
  mallStores      MallStore[]

  @@index([categoryId])
  @@index([status])
}

model MallStore {
  id               String      @id @default(cuid())
  tenantId         String
  mallId           String
  globalStoreId    String
  localName        String?
  localDescription String?
  localLogoMediaId String?
  floor            String?
  storeNo          String?
  phone            String?
  email            String?
  workingHoursJson Json?
  locationJson     Json?
  isFeatured       Boolean     @default(false)
  sortOrder        Int         @default(0)
  status           StoreStatus @default(ACTIVE)
  createdBy        String
  updatedBy        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall             Mall         @relation(fields: [mallId], references: [id], onDelete: Cascade)
  globalStore      GlobalStore  @relation(fields: [globalStoreId], references: [id], onDelete: Restrict)
  localLogoMedia   MediaAsset?  @relation("MallStoreLocalLogo", fields: [localLogoMediaId], references: [id], onDelete: SetNull)
  createdByUser    User         @relation("MallStoreCreator", fields: [createdBy], references: [id])
  updatedByUser    User?        @relation("MallStoreUpdater", fields: [updatedBy], references: [id])
  campaigns        Campaign[]

  @@index([tenantId, mallId])
  @@index([globalStoreId])
  @@index([tenantId, mallId, status])
}

// ─── Events & Campaigns (Sprint 6) ────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Event {
  id                  String        @id @default(cuid())
  tenantId            String
  mallId              String?
  title               String
  slug                String
  shortDescription    String?
  description         String?
  coverMediaId        String?
  startAt             DateTime?
  endAt               DateTime?
  location            String?
  category            String?
  buttonText          String?
  linkUrl             String?
  status              ContentStatus @default(DRAFT)
  sortOrder           Int           @default(0)
  dynamicFieldsJson   Json?
  createdBy           String
  updatedBy           String?
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall            Mall?       @relation(fields: [mallId], references: [id], onDelete: SetNull)
  coverMedia      MediaAsset? @relation("EventCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdByUser   User        @relation("EventCreator", fields: [createdBy], references: [id])
  updatedByUser   User?       @relation("EventUpdater", fields: [updatedBy], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, mallId])
  @@index([tenantId, sortOrder])
  @@index([tenantId, startAt])
}

model Campaign {
  id                  String        @id @default(cuid())
  tenantId            String
  mallId              String?
  storeId             String?
  title               String
  slug                String
  shortDescription    String?
  description         String?
  coverMediaId        String?
  startAt             DateTime?
  endAt               DateTime?
  terms               String?
  couponCode          String?
  buttonText          String?
  linkUrl             String?
  status              ContentStatus @default(DRAFT)
  sortOrder           Int           @default(0)
  dynamicFieldsJson   Json?
  createdBy           String
  updatedBy           String?
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall            Mall?       @relation(fields: [mallId], references: [id], onDelete: SetNull)
  store           MallStore?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  coverMedia      MediaAsset? @relation("CampaignCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdByUser   User        @relation("CampaignCreator", fields: [createdBy], references: [id])
  updatedByUser   User?       @relation("CampaignUpdater", fields: [updatedBy], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, mallId])
  @@index([tenantId, storeId])
  @@index([tenantId, sortOrder])
}

// ─── Cinema & sessions (Sprint 8) ─────────────────────────────────────────────

enum CinemaStatus {
  ACTIVE
  PASSIVE
  ARCHIVED
}

enum MovieStatus {
  ACTIVE
  PASSIVE
  ARCHIVED
}

enum MovieSessionStatus {
  SCHEDULED
  CANCELLED
  ARCHIVED
}

enum CinemaProviderType {
  MANUAL
  API
  XML_FEED
}

model Cinema {
  id                 String             @id @default(cuid())
  tenantId           String
  mallId             String
  name               String
  slug               String
  logoMediaId        String?
  description        String?
  providerType       CinemaProviderType @default(MANUAL)
  providerConfigJson Json?
  status             CinemaStatus       @default(ACTIVE)
  createdBy          String
  updatedBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall            Mall         @relation(fields: [mallId], references: [id], onDelete: Cascade)
  logoMedia       MediaAsset?  @relation("CinemaLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  createdByUser   User         @relation("CinemaCreator", fields: [createdBy], references: [id])
  updatedByUser   User?        @relation("CinemaUpdater", fields: [updatedBy], references: [id])
  movieSessions   MovieSession[]

  @@unique([mallId, slug])
  @@index([tenantId, mallId])
  @@index([tenantId, status])
}

model Movie {
  id              String      @id @default(cuid())
  tenantId        String
  title           String
  slug            String
  originalTitle   String?
  posterMediaId   String?
  description     String?
  durationMinutes Int?
  genre           String?
  rating          String?
  trailerUrl      String?
  releaseDate     DateTime?
  status          MovieStatus @default(ACTIVE)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posterMedia     MediaAsset?    @relation("MoviePosterMedia", fields: [posterMediaId], references: [id], onDelete: SetNull)
  createdByUser   User           @relation("MovieCreator", fields: [createdBy], references: [id])
  updatedByUser   User?          @relation("MovieUpdater", fields: [updatedBy], references: [id])
  movieSessions   MovieSession[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, title])
}

model MovieSession {
  id         String             @id @default(cuid())
  tenantId   String
  mallId     String
  cinemaId   String
  movieId    String
  hallName   String?
  startsAt   DateTime
  endsAt     DateTime?
  language   String?
  subtitle   String?
  format     String?
  ticketUrl  String?
  status     MovieSessionStatus @default(SCHEDULED)
  createdBy  String
  updatedBy  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall            Mall         @relation(fields: [mallId], references: [id], onDelete: Cascade)
  cinema          Cinema       @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  movie           Movie        @relation(fields: [movieId], references: [id], onDelete: Restrict)
  createdByUser   User         @relation("MovieSessionCreator", fields: [createdBy], references: [id])
  updatedByUser   User?        @relation("MovieSessionUpdater", fields: [updatedBy], references: [id])

  @@index([tenantId, mallId, startsAt])
  @@index([cinemaId, startsAt])
  @@index([movieId])
  @@index([tenantId, status])
}
