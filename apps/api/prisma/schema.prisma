generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  DELETED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum MallStatus {
  DRAFT
  LIVE
  MAINTENANCE
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String?
  lastName     String?
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenantUsers    TenantUser[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]    @relation("AuditActor")
  mediaFolders   MediaFolder[] @relation("FolderCreator")
  uploadedAssets MediaAsset[]  @relation("AssetUploader")
  createdSliders Slider[]      @relation("SliderCreator")
  updatedSliders Slider[]      @relation("SliderUpdater")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  malls        Mall[]
  tenantUsers  TenantUser[]
  auditLogs    AuditLog[]
  mediaFolders MediaFolder[]
  mediaAssets  MediaAsset[]
  sliders      Slider[]
}

model Mall {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  status    MallStatus @default(LIVE)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userMallAccesses UserMallAccess[]
  auditLogs        AuditLog[]
  mediaFolders     MediaFolder[]
  mediaAssets      MediaAsset[]
  sliders          Slider[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantUsers     TenantUser[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model TenantUser {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  mallAccess UserMallAccess[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

model UserMallAccess {
  id           String     @id @default(cuid())
  tenantUserId String
  mallId       String
  tenantUser   TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  mall         Mall       @relation(fields: [mallId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([tenantUserId, mallId])
  @@index([mallId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  mallId      String?
  mall        Mall?    @relation(fields: [mallId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

// ─── Media ────────────────────────────────────────────────────────────────────

model MediaFolder {
  id        String   @id @default(cuid())
  tenantId  String
  mallId    String?
  parentId  String?
  name      String
  slug      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall     Mall?         @relation(fields: [mallId], references: [id], onDelete: SetNull)
  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderHierarchy")
  creator  User          @relation("FolderCreator", fields: [createdBy], references: [id])
  assets   MediaAsset[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([mallId])
}

model MediaAsset {
  id           String    @id @default(cuid())
  tenantId     String
  mallId       String?
  folderId     String?
  uploadedBy   String
  originalName String
  fileName     String
  mimeType     String
  extension    String
  size         Int
  width        Int?
  height       Int?
  storageKey   String    @unique
  publicUrl    String
  altText      String?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall     Mall?        @relation(fields: [mallId], references: [id], onDelete: SetNull)
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader User         @relation("AssetUploader", fields: [uploadedBy], references: [id])

  slidersDesktop Slider[] @relation("SliderDesktopMedia")
  slidersMobile  Slider[] @relation("SliderMobileMedia")
  slidersVideo   Slider[] @relation("SliderVideoMedia")

  @@index([tenantId, createdAt])
  @@index([tenantId, folderId])
  @@index([mallId])
}

// ─── Sliders ──────────────────────────────────────────────────────────────────

enum SliderStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SliderTargetDevice {
  ALL
  DESKTOP
  MOBILE
}

enum SliderLinkType {
  NONE
  EXTERNAL_URL
  INTERNAL_PAGE
  EVENT
  CAMPAIGN
  STORE
}

model Slider {
  id             String             @id @default(cuid())
  tenantId       String
  mallId         String?
  title          String
  subtitle       String?
  description    String?
  desktopMediaId String?
  mobileMediaId  String?
  videoMediaId   String?
  linkType       SliderLinkType     @default(NONE)
  linkValue      String?
  buttonText     String?
  startAt        DateTime?
  endAt          DateTime?
  sortOrder      Int                @default(0)
  status         SliderStatus       @default(DRAFT)
  targetDevice   SliderTargetDevice @default(ALL)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mall          Mall?       @relation(fields: [mallId], references: [id], onDelete: SetNull)
  desktopMedia  MediaAsset? @relation("SliderDesktopMedia", fields: [desktopMediaId], references: [id], onDelete: SetNull)
  mobileMedia   MediaAsset? @relation("SliderMobileMedia", fields: [mobileMediaId], references: [id], onDelete: SetNull)
  videoMedia    MediaAsset? @relation("SliderVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)
  createdByUser User        @relation("SliderCreator", fields: [createdBy], references: [id])
  updatedByUser User?       @relation("SliderUpdater", fields: [updatedBy], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, mallId])
  @@index([tenantId, sortOrder])
}
