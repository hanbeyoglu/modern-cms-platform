{
  "name": "@modern-cms/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "prisma generate --schema ../api/prisma/schema.prisma",
    "build": "pnpm run prebuild && tsc -p tsconfig.build.json",
    "dev": "pnpm run prebuild && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "pnpm run prebuild && tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modern-cms/content-scheduling": "workspace:*",
    "@prisma/client": "^6.1.0",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
