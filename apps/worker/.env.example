# @modern-cms/worker — zamanlama işçisi (Prisma şeması apps/api ile paylaşılır)

# ─── Zorunlu ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms?schema=public
REDIS_URL=redis://localhost:6379

# ─── İsteğe bağlı ───────────────────────────────────────────────────────────
NODE_ENV=development
WORKER_POLL_INTERVAL_MS=60000
# SCHEDULING_BATCH_SIZE=40

# SMTP (iletişim mesajı bildirimleri)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Modern CMS <noreply@example.com>"

# Docker metadata
# APP_VERSION=0.0.0
# APP_GIT_SHA=
# APP_BUILD_TIME=
