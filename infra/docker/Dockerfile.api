# syntax=docker/dockerfile:1
FROM node:20-bookworm-slim AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@modern-cms/api

RUN pnpm --filter @modern-cms/api deploy --prod /deploy \
  && rm -rf /deploy/src \
  && find /deploy -name "*.tsbuildinfo" -delete

# pnpm deploy reinstalls @prisma/client without a generated engine; copy from the build tree.
RUN set -eux; \
  SRC="$(find /app/node_modules/.pnpm -path '*/node_modules/.prisma/client/index.js' -size +100k | head -1 | xargs dirname)"; \
  DST="$(find /deploy/node_modules/.pnpm -path '*/node_modules/.prisma/client' -type d | head -1)"; \
  test -n "${SRC}" && test -n "${DST}"; \
  rm -rf "${DST}"; \
  cp -a "${SRC}" "${DST}"

FROM node:20-bookworm-slim AS runner
WORKDIR /app

ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG APP_VERSION=0.0.0
ENV NODE_ENV=production
ENV APP_GIT_SHA=${GIT_SHA}
ENV APP_BUILD_TIME=${BUILD_TIME}
ENV APP_VERSION=${APP_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 nodejs \
  && useradd --uid 1001 --gid nodejs --shell /bin/bash --create-home nestjs

COPY --from=build --chown=nestjs:nodejs /deploy /app

USER nestjs
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||4000)+'/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
