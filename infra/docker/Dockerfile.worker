# syntax=docker/dockerfile:1
FROM node:20-bookworm-slim AS dependencies
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
  && pnpm config set store-dir /pnpm/store

# Source-only edits must not invalidate dependency installation.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/admin/package.json ./apps/admin/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY packages/config/package.json ./packages/config/
COPY packages/content-scheduling/package.json ./packages/content-scheduling/
COPY packages/mail/package.json ./packages/mail/
COPY packages/movie-providers/package.json ./packages/movie-providers/
COPY packages/notifications/package.json ./packages/notifications/
COPY packages/public-sdk/package.json ./packages/public-sdk/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/

RUN --mount=type=cache,id=modern-cms-pnpm,target=/pnpm/store \
  PRISMA_SKIP_POSTINSTALL_GENERATE=true pnpm install --frozen-lockfile

FROM dependencies AS build
COPY turbo.json ./
COPY packages ./packages
COPY apps ./apps

# Reuse unchanged workspace outputs across API/worker builds; limit memory pressure.
RUN --mount=type=cache,id=modern-cms-turbo,target=/turbo-cache,sharing=locked \
  pnpm turbo run build --filter=@modern-cms/worker --concurrency=1 --cache-dir=/turbo-cache

RUN --mount=type=cache,id=modern-cms-pnpm,target=/pnpm/store \
  pnpm --filter @modern-cms/worker deploy --prod /deploy \
  && rm -rf /deploy/src \
  && find /deploy -name "*.tsbuildinfo" -delete

# pnpm deploy reinstalls @prisma/client without a generated engine; copy from the build tree.
RUN set -eux; \
  SRC="$(find /app/node_modules/.pnpm -path '*/node_modules/.prisma/client/index.js' -size +100k | head -1 | xargs dirname)"; \
  DST="$(find /deploy/node_modules/.pnpm -path '*/node_modules/.prisma/client' -type d | head -1)"; \
  test -n "${SRC}" && test -n "${DST}"; \
  rm -rf "${DST}"; \
  cp -a "${SRC}" "${DST}"


FROM node:20-bookworm-slim AS runner
WORKDIR /app

ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG APP_VERSION=0.0.0
ENV NODE_ENV=production
ENV APP_GIT_SHA=${GIT_SHA}
ENV APP_BUILD_TIME=${BUILD_TIME}
ENV APP_VERSION=${APP_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 nodejs \
  && useradd --uid 1001 --gid nodejs --shell /bin/bash --create-home worker

COPY --from=build --chown=worker:nodejs /deploy /app

USER worker

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "const Redis=require('ioredis');const u=process.env.REDIS_URL||'redis://localhost:6379';const r=new Redis(u,{maxRetriesPerRequest:1,connectTimeout:3000});r.get('worker:heartbeat').then(v=>r.quit().then(()=>process.exit(v?0:1))).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
