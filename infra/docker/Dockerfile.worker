# syntax=docker/dockerfile:1
FROM node:20-bookworm-slim AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@modern-cms/worker

RUN pnpm --filter @modern-cms/worker deploy --prod /deploy \
  && rm -rf /deploy/src \
  && find /deploy -name "*.tsbuildinfo" -delete

FROM node:20-bookworm-slim AS runner
WORKDIR /app

ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG APP_VERSION=0.0.0
ENV NODE_ENV=production
ENV APP_GIT_SHA=${GIT_SHA}
ENV APP_BUILD_TIME=${BUILD_TIME}
ENV APP_VERSION=${APP_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 nodejs \
  && useradd --uid 1001 --gid nodejs --shell /bin/bash --create-home worker

COPY --from=build --chown=worker:nodejs /deploy /app

USER worker

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "const Redis=require('ioredis');const u=process.env.REDIS_URL||'redis://localhost:6379';const r=new Redis(u,{maxRetriesPerRequest:1,connectTimeout:3000});r.get('worker:heartbeat').then(v=>r.quit().then(()=>process.exit(v?0:1))).catch(()=>process.exit(1)))"

CMD ["node", "dist/index.js"]
